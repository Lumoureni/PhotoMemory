.page {
  padding: 24rpx 24rpx 64rpx;
}

.stage {
  overflow: hidden;
  margin-bottom: 20rpx;
}

.photo {
  width: 100%;
  height: 520rpx;
  display: block;
  background: #12100e;
}

.bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.index {
  font-size: 22rpx;
  letter-spacing: 0.18em;
}

.side {
  padding: 28rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 400;
  margin-bottom: 8rpx;
}

.note {
  margin-top: 16rpx;
  font-style: italic;
  color: rgba(242, 235, 224, 0.72);
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 28rpx;
}

.sm {
  font-size: 24rpx;
  padding: 12rpx 22rpx;
}

.danger {
  color: #c47a6a;
  border-color: rgba(196, 122, 106, 0.35);
}

.label {
  font-size: 20rpx;
  letter-spacing: 0.18em;
  color: #9A8F82;
  margin: 16rpx 0 8rpx;
}

.input,
.textarea {
  background: #0E0C0A;
  border: 1rpx solid rgba(242, 235, 224, 0.08);
  border-radius: 4rpx;
  padding: 16rpx 20rpx;
  color: #F2EBE0;
  font-size: 28rpx;
  width: 100%;
}

.textarea {
  min-height: 120rpx;
}
