.page {
  padding: 32rpx 32rpx 80rpx;
}

.title {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

.sub {
  margin-bottom: 28rpx;
}

.drop {
  position: relative;
  min-height: 280rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-style: dashed;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.drop-title {
  text-align: center;
  margin-bottom: 8rpx;
}

.preview {
  width: 100%;
  height: 360rpx;
  display: block;
}

.clear {
  position: absolute;
  top: 12rpx;
  right: 16rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(14, 12, 10, 0.7);
  border: 1rpx solid rgba(242, 235, 224, 0.16);
  border-radius: 50%;
  font-size: 32rpx;
  color: #F2EBE0;
}

.form {
  padding: 28rpx;
}

.label {
  font-size: 20rpx;
  letter-spacing: 0.18em;
  color: #9A8F82;
  margin: 20rpx 0 10rpx;
  text-transform: uppercase;
}

.label:first-child {
  margin-top: 0;
}

.input,
.textarea {
  background: #0E0C0A;
  border: 1rpx solid rgba(242, 235, 224, 0.08);
  border-radius: 4rpx;
  padding: 18rpx 22rpx;
  color: #F2EBE0;
  font-size: 28rpx;
  width: 100%;
}

.textarea {
  min-height: 140rpx;
}

.save {
  margin-top: 32rpx;
}
