.page {
  padding: 32rpx 32rpx 64rpx;
}

.head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 28rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 400;
  letter-spacing: 0.04em;
}

.count {
  font-size: 24rpx;
}

.tools {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.search {
  background: #1A1613;
  border: 1rpx solid rgba(242, 235, 224, 0.08);
  border-radius: 999rpx;
  padding: 14rpx 28rpx;
  color: #F2EBE0;
  font-size: 26rpx;
}

.chips {
  display: flex;
  gap: 12rpx;
}

.chip {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(242, 235, 224, 0.08);
  color: #9A8F82;
  font-size: 24rpx;
}

.chip.on {
  background: #C4A574;
  color: #0E0C0A;
  border-color: #C4A574;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.item {
  position: relative;
  width: calc(50% - 8rpx);
  overflow: hidden;
}

.img {
  width: 100%;
  height: 360rpx;
  display: block;
  background: #221c17;
}

.meta {
  padding: 16rpx 18rpx 20rpx;
}

.name {
  font-size: 28rpx;
  margin-bottom: 4rpx;
}

.fav {
  position: absolute;
  top: 12rpx;
  right: 16rpx;
  color: rgba(242, 235, 224, 0.75);
  font-size: 28rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.6);
}

.fav.on {
  color: #C4A574;
}

.center {
  text-align: center;
  padding: 80rpx 0;
}

.empty {
  text-align: center;
  padding: 100rpx 24rpx;
}

.empty-title {
  font-size: 36rpx;
  margin-bottom: 12rpx;
}

.error {
  text-align: center;
  padding: 60rpx 20rpx;
  color: #c47a6a;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  align-items: center;
}
